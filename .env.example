# ── Database ──────────────────────────────────────────────────────────────────
# TiDB Serverless connection string (MySQL-compatible)
# Format: mysql://user:password@host:port/dbname?ssl-mode=VERIFY_IDENTITY
DATABASE_URL=mysql://root:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/bvc?ssl-mode=VERIFY_IDENTITY

# ── Auth ──────────────────────────────────────────────────────────────────────
# Random 64-char hex string: openssl rand -hex 32
JWT_SECRET=change_me_use_openssl_rand_hex_32

# Optional: this account is made admin automatically on first sign-in,
# which saves granting the first admin by hand in SQL.
# Format: email:<address> — e.g. email:you@bundabergvoicecollective.com.au
# OWNER_OPEN_ID=

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=bvc-storage
# Optional: set to your R2 custom domain or public bucket URL
# R2_PUBLIC_URL=https://files.bundabergvoicecollective.com.au

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Resend SMTP (recommended free tier)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM=BVC <noreply@bundabergvoicecollective.com.au>

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@bundabergvoicecollective.com.au

# ── Square Payments ───────────────────────────────────────────────────────────
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://bundabergvoicecollective.com.au/api/square/webhook

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
